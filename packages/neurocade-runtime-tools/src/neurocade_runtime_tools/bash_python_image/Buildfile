Bootstrap: docker
From: python:3.12-slim

%labels
    Author NeuroCade
    Description Minimal Python 3.12 neuroimaging toolbox image for neurocade_runtime_tools

%post
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        ffmpeg \
        libegl1 \
        libgl1 \
        libgl1-mesa-dri \
        libglib2.0-0 \
        libgomp1 \
        libosmesa6 \
        libxrender1 \
        libxt6 \
        pkg-config
    rm -rf /var/lib/apt/lists/*

    python3.12 -m pip install --no-cache-dir --no-compile --upgrade pip setuptools wheel
    # neuroreg depends on PyTorch. Install the CPU wheel first so the runtime
    # image does not vendor multi-gigabyte CUDA libraries by default.
    python3.12 -m pip install --no-cache-dir --no-compile \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.12.0+cpu
    python3.12 -m pip install --no-cache-dir --no-compile \
        antspyx \
        dipy \
        h5py \
        hydra-core \
        lapy==1.6.0 \
        matplotlib \
        mne \
        nibabel \
        nilearn \
        neuroreg==0.6.0 \
        nipype \
        nitransforms \
        numpy \
        pandas \
        pydicom \
        pybids \
        scikit-image \
        scikit-learn \
        scipy \
        simpleitk \
        surfa==0.6.3 \
        templateflow
    # FireANTs 1.5.0 pins simpleitk==2.2.1, which is not available for Python 3.12.
    # The image already installs a newer SimpleITK, so install the pure-Python wheel without dependency backtracking.
    python3.12 -m pip install --no-cache-dir --no-compile --no-deps fireants==1.5.0
    python3.12 -m pip install --no-cache-dir --no-compile whippersnappy==2.1.0

    apt-get purge -y --auto-remove build-essential pkg-config
    apt-get clean
    find /usr/local/lib/python3.12/site-packages \
        -type d \( -name test -o -name tests -o -name __pycache__ \) -prune -exec rm -rf '{}' +
    find /usr/local/lib/python3.12/site-packages \
        -type f \( \
            -name '*.pyc' -o \
            -name '*.pyo' -o \
            -name '*.a' -o \
            -name '*.c' -o \
            -name '*.cc' -o \
            -name '*.cpp' -o \
            -name '*.h' -o \
            -name '*.hpp' -o \
            -name '*.pxd' -o \
            -name '*.pxi' -o \
            -name '*.pyx' \
        \) -delete
    find /usr/local /usr/lib -type f -name '*.a' -delete
    rm -rf /root/.cache /var/cache/apt/* /var/lib/apt/lists/* \
        /usr/local/share/jupyter /usr/share/doc /usr/share/info /usr/share/lintian \
        /usr/share/man /usr/share/locale

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONDONTWRITEBYTECODE=1
    export MPLBACKEND=Agg

%runscript
    exec python3.12 "$@"
