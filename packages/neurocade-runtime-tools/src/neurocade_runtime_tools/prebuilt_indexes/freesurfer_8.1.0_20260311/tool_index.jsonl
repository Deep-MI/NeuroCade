{"name":"mri_info","synopsis":"mri_info [options] <volume>","description":"Report MRI volume dimensions, geometry, orientation, and header metadata.","arguments":[{"name":"--vox2ras","description":"Print voxel-to-RAS transform."},{"name":"--dim","description":"Print volume dimensions."},{"name":"--res","description":"Print voxel resolution."}],"outputs":[{"name":"stdout","description":"Requested metadata values."}],"categories":["core","freesurfer","metadata"]}
{"name":"mri_convert","synopsis":"mri_convert [options] <input> <output>","description":"Convert MRI volumes between FreeSurfer, MGZ, MGH, NIfTI, and other supported formats.","arguments":[{"name":"--out_type TYPE","description":"Set output format."},{"name":"--reslice_like TEMPLATE","description":"Reslice output like a template volume."},{"name":"--conform","description":"Conform input to canonical FreeSurfer geometry."}],"outputs":[{"name":"output volume","description":"Converted MRI volume."}],"categories":["core","freesurfer","conversion"]}
{"name":"mri_binarize","synopsis":"mri_binarize --i <input> --o <output> [options]","description":"Create binary masks from MRI volumes using thresholds, labels, or match criteria.","arguments":[{"name":"--i FILE","description":"Input volume."},{"name":"--o FILE","description":"Output binary mask."},{"name":"--min VALUE","description":"Minimum threshold."},{"name":"--match LABELS","description":"Include matching segmentation labels."}],"outputs":[{"name":"mask volume","description":"Binarized output volume."}],"categories":["core","freesurfer","masking"]}
{"name":"mri_vol2vol","synopsis":"mri_vol2vol --mov <moving> --targ <target> --o <output> [options]","description":"Resample or register a moving MRI volume into a target volume space.","arguments":[{"name":"--mov FILE","description":"Moving input volume."},{"name":"--targ FILE","description":"Target reference volume."},{"name":"--reg FILE","description":"Registration matrix."},{"name":"--o FILE","description":"Output volume."}],"outputs":[{"name":"output volume","description":"Resampled volume."}],"categories":["core","freesurfer","registration"]}
{"name":"mri_label2vol","synopsis":"mri_label2vol --label <label> --temp <template> --o <output> [options]","description":"Convert surface or label annotations into a volumetric mask or segmentation.","arguments":[{"name":"--label FILE","description":"Input label file."},{"name":"--temp FILE","description":"Template volume."},{"name":"--reg FILE","description":"Registration matrix."},{"name":"--o FILE","description":"Output volume."}],"outputs":[{"name":"output volume","description":"Volumetric label result."}],"categories":["core","freesurfer","labeling"]}
{"name":"mri_segstats","synopsis":"mri_segstats --seg <segmentation> --sum <summary> [options]","description":"Compute per-label segmentation statistics from a FreeSurfer segmentation volume.","arguments":[{"name":"--seg FILE","description":"Segmentation volume."},{"name":"--sum FILE","description":"Summary output file."},{"name":"--ctab FILE","description":"Color table."},{"name":"--in FILE","description":"Intensity volume for statistics."}],"outputs":[{"name":"summary file","description":"Per-label statistics table."}],"categories":["core","freesurfer","statistics"]}
{"name":"mri_synthstrip","synopsis":"mri_synthstrip -i <input> -o <output> [options]","description":"Run SynthStrip skull stripping for brain extraction from MRI volumes.","arguments":[{"name":"-i FILE","description":"Input MRI volume."},{"name":"-o FILE","description":"Skull-stripped output volume."},{"name":"-m FILE","description":"Optional brain mask output."},{"name":"--no-csf","description":"Exclude CSF from the brain mask."}],"outputs":[{"name":"output volume","description":"Skull-stripped MRI volume."},{"name":"mask volume","description":"Brain mask when requested."}],"categories":["core","freesurfer","skullstrip"]}
{"name":"mri_synthseg","synopsis":"mri_synthseg --i <input> --o <segmentation> [options]","description":"Run SynthSeg whole-brain segmentation on MRI volumes without requiring contrast-specific preprocessing.","arguments":[{"name":"--i FILE","description":"Input MRI volume."},{"name":"--o FILE","description":"Output segmentation volume."},{"name":"--vol FILE","description":"Optional volume statistics output."},{"name":"--qc FILE","description":"Optional quality-control output."}],"outputs":[{"name":"segmentation volume","description":"SynthSeg label map."},{"name":"statistics table","description":"Optional per-region volumes."}],"categories":["core","freesurfer","segmentation"]}
{"name":"asegstats2table","synopsis":"asegstats2table --subjects <subjects> --meas <measure> --tablefile <file>","description":"Convert FreeSurfer aseg.stats files for multiple subjects into a tabular report.","arguments":[{"name":"--subjects SUBJECTS","description":"Subject identifiers to include."},{"name":"--meas MEASURE","description":"Statistic to extract."},{"name":"--tablefile FILE","description":"Output table path."},{"name":"--subjectsfile FILE","description":"Read subject identifiers from a file."}],"outputs":[{"name":"table file","description":"Tabular aseg statistics."}],"categories":["core","freesurfer","statistics"]}
{"name":"aparcstats2table","synopsis":"aparcstats2table --subjects <subjects> --hemi <lh|rh> --meas <measure> --tablefile <file>","description":"Convert FreeSurfer aparc.stats cortical parcellation files into a tabular report.","arguments":[{"name":"--subjects SUBJECTS","description":"Subject identifiers to include."},{"name":"--hemi lh|rh","description":"Hemisphere to report."},{"name":"--meas MEASURE","description":"Statistic to extract."},{"name":"--tablefile FILE","description":"Output table path."}],"outputs":[{"name":"table file","description":"Tabular aparc statistics."}],"categories":["core","freesurfer","statistics"]}
{"name":"recon-all","synopsis":"recon-all -subject <subject> -i <input> [options]","description":"Run FreeSurfer cortical reconstruction and anatomical processing workflows.","arguments":[{"name":"-subject SUBJECT","description":"Subject identifier."},{"name":"-i FILE","description":"Input anatomical volume."},{"name":"-all","description":"Run the full reconstruction pipeline."},{"name":"-autorecon1|-autorecon2|-autorecon3","description":"Run a selected reconstruction stage."}],"outputs":[{"name":"subjects directory","description":"FreeSurfer subject reconstruction outputs."}],"categories":["core","freesurfer","reconstruction"]}
