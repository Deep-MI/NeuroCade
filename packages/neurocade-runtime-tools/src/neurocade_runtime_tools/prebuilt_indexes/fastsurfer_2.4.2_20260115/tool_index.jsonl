{"name":"run_fastsurfer.sh","synopsis":"run_fastsurfer.sh --t1 <image> --sid <subject> --sd <subjects_dir> [options]","description":"Run the FastSurfer cortical reconstruction and segmentation workflow.","arguments":[{"name":"--t1 IMAGE","description":"Input T1-weighted MRI image."},{"name":"--sid SUBJECT","description":"Subject identifier."},{"name":"--sd DIR","description":"Subjects directory for outputs."},{"name":"--seg_only","description":"Run segmentation only."}],"outputs":[{"name":"subjects directory","description":"FastSurfer subject outputs."}],"categories":["core","segmentation","fastsurfer"],"aliases":["fastsurfer"]}
{"name":"mri_info","synopsis":"mri_info [options] <volume>","description":"Report MRI volume dimensions, geometry, orientation, and header metadata.","arguments":[{"name":"--vox2ras","description":"Print voxel-to-RAS transform."},{"name":"--dim","description":"Print volume dimensions."},{"name":"--res","description":"Print voxel resolution."}],"outputs":[{"name":"stdout","description":"Requested metadata values."}],"categories":["core","freesurfer","metadata"]}
{"name":"mri_convert","synopsis":"mri_convert [options] <input> <output>","description":"Convert MRI volumes between FreeSurfer, MGZ, MGH, NIfTI, and other supported formats.","arguments":[{"name":"--out_type TYPE","description":"Set output format."},{"name":"--reslice_like TEMPLATE","description":"Reslice output like a template volume."},{"name":"--conform","description":"Conform input to canonical FreeSurfer geometry."}],"outputs":[{"name":"output volume","description":"Converted MRI volume."}],"categories":["core","freesurfer","conversion"]}
{"name":"mri_binarize","synopsis":"mri_binarize --i <input> --o <output> [options]","description":"Create binary masks from MRI volumes using thresholds, labels, or match criteria.","arguments":[{"name":"--i FILE","description":"Input volume."},{"name":"--o FILE","description":"Output binary mask."},{"name":"--min VALUE","description":"Minimum threshold."},{"name":"--match LABELS","description":"Include matching segmentation labels."}],"outputs":[{"name":"mask volume","description":"Binarized output volume."}],"categories":["core","freesurfer","masking"]}
{"name":"mri_vol2vol","synopsis":"mri_vol2vol --mov <moving> --targ <target> --o <output> [options]","description":"Resample or register a moving MRI volume into a target volume space.","arguments":[{"name":"--mov FILE","description":"Moving input volume."},{"name":"--targ FILE","description":"Target reference volume."},{"name":"--reg FILE","description":"Registration matrix."},{"name":"--o FILE","description":"Output volume."}],"outputs":[{"name":"output volume","description":"Resampled volume."}],"categories":["core","freesurfer","registration"]}
{"name":"mri_label2vol","synopsis":"mri_label2vol --label <label> --temp <template> --o <output> [options]","description":"Convert surface or label annotations into a volumetric mask or segmentation.","arguments":[{"name":"--label FILE","description":"Input label file."},{"name":"--temp FILE","description":"Template volume."},{"name":"--reg FILE","description":"Registration matrix."},{"name":"--o FILE","description":"Output volume."}],"outputs":[{"name":"output volume","description":"Volumetric label result."}],"categories":["core","freesurfer","labeling"]}
{"name":"mri_segstats","synopsis":"mri_segstats --seg <segmentation> --sum <summary> [options]","description":"Compute per-label segmentation statistics from a FreeSurfer segmentation volume.","arguments":[{"name":"--seg FILE","description":"Segmentation volume."},{"name":"--sum FILE","description":"Summary output file."},{"name":"--ctab FILE","description":"Color table."},{"name":"--in FILE","description":"Intensity volume for statistics."}],"outputs":[{"name":"summary file","description":"Per-label statistics table."}],"categories":["core","freesurfer","statistics"]}
