DEPLOYMENT_PROFILE=local
NEUROCADE_VERSION_CHECK_URL=https://NeuroCade.org/latest.json
NEUROCADE_UPDATE_CHECK_INTERVAL_SECONDS=86400
APP_BASE_URL=http://localhost:8000
APP_ALLOWED_HOSTS=localhost,127.0.0.1

# Required matched application/tool runtime. Rerun the installer to switch.
NEUROCADE_RUNTIME=docker
NEUROCADE_BRIDGE_URL=http://host.docker.internal:8765
NEUROCADE_BRIDGE_TOKEN_FILE=/run/neurocade/bridge-token
NEUROCADE_BRIDGE_PORT=8765
NEUROCADE_BRIDGE_PACKAGE=

# Host-side data root mounted into the application as /data.
NEUROCADE_IMAGE=ghcr.io/deep-mi/neurocade:latest
HOST_DATA_DIR=./neurocade-data
# Docker stores SQLite in this native Linux named volume. Apptainer stores it
# under .runtime/database on the native Linux host.
NEUROCADE_DATABASE_VOLUME=neurocade-database
# Apptainer installs set this to release or source. Rerun the installer to
# refresh the verified SIF and matched host bridge.
NEUROCADE_APP_SIF_MODE=
NEUROCADE_RELEASE_VERSION=
# Apple Silicon uses emulated amd64 NeuroDesk tools. The installer sets this
# automatically on Darwin arm64; leave blank on Linux unless overriding it.
NEUROCADE_DOCKER_PLATFORM=
NEUROCADE_SAMPLE_CASE_URL=https://github.com/Deep-MI/NeuroCade/releases/download/v2026.6.7/neurocade-sample-case-FastSurfer_Rhineland_0000.tar.gz
NEUROCADE_SAMPLE_CASE_SHA256=71814b4687180e10543523bb07292725f4b165acce7d0f9d34148028daa061b7
# In-process job worker concurrency (FastSurfer is GPU-bound -> keep at 1).
API_WORKER_CONCURRENCY=2
FASTSURFER_CONCURRENCY=1
DICOM_CONVERSION_TIMEOUT_SECONDS=300
NEUROCADE_DCM2NIIX_IMAGE=vnmd/dcm2niix_v1.0.20240202:20260512
MAX_UPLOAD_FILE_SIZE_BYTES=2147483648
DICOM_ZIP_MAX_ENTRIES=5000
DICOM_ZIP_MAX_EXPANDED_BYTES=4294967296

APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8000

# SQLite is the only database. The launcher injects its /database URL.

# auto uses CUDA only after the host bridge validates the runtime and tool image.
# Use cuda to require a GPU at startup or cpu to disable GPU execution.
NEUROCADE_GPU_MODE=auto
# The Docker launcher defaults to the invoking host user's numeric identity.
# NEUROCADE_UID=1000
# NEUROCADE_GID=1000
ASSISTANT_MAX_ROUNDS=18
ASSISTANT_WORKFLOW_WAIT_SECONDS=300
ASSISTANT_GUI_ACK_WAIT_SECONDS=10
# Private history and final model-prompt bounds. Any omitted or compacted context
# is explicitly marked in the model input; newest conversation is retained first.
ASSISTANT_HISTORY_MAX_MESSAGES=40
ASSISTANT_HISTORY_MAX_CHARACTERS=120000
ASSISTANT_HISTORY_MAX_TOKENS=30000
ASSISTANT_HISTORY_KEEP_RECENT_TOKENS=12000
ASSISTANT_PROMPT_MAX_CHARACTERS=120000
ASSISTANT_PROMPT_MAX_TOKENS=30000
JOB_HISTORY_RETENTION_DAYS=30
MONITORING_ADMIN_USER_IDS=demo-user
MONITORING_ACTIVE_WINDOW_MINUTES=15
MONITORING_EVENT_RETENTION_DAYS=30

# Local installs only. Keep false for any shared deployment.
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USER_ID=local-user
LOCAL_AUTH_EMAIL=local@example.com
LOCAL_AUTH_NAME=Local User
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_TEMPLATE=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

LLM_PROVIDER_DEFAULT=openai-compatible
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# LLM Backend (OpenAI-compatible endpoint)
# Configure your OpenAI-compatible base URL. `backend_common.providers` appends /v1.
# Leave LLM_BACKEND_API_KEY blank for no-auth backends.
LLM_BACKEND_URL=
LLM_BACKEND_API_KEY=
LLM_BACKEND_MODEL=Qwen/Qwen3.6-35B-A3B

# Optional: local Gemma 4 via Ollama
# Start the app with: ./scripts/run.sh start -d
# The current recommended model for ~16 GB GPUs is gemma4:e2b.
# LLM_BACKEND_URL=http://host.docker.internal:11434
# LLM_BACKEND_API_KEY=
# LLM_BACKEND_MODEL=gemma4:e2b
# OLLAMA_MODEL=gemma4:e2b
