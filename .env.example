HUGGING_FACE_HUB_TOKEN=NOTSET
LLM_API_TOKEN=CHANGE_ME

DEPLOYMENT_PROFILE=local
CLIENT_SERVE_MODE=static
APP_NAME=NeuroCade
NEUROCADE_VERSION=0.0.0
NEUROCADE_VERSION_CHECK_URL=https://NeuroCade.org/latest.json
NEUROCADE_UPDATE_CHECK_INTERVAL_SECONDS=86400
APP_BASE_URL=http://localhost:8005
APP_PUBLIC_URL=http://localhost:8005
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_DOMAIN=
ACME_EMAIL=

UID=NOTSET
GID=1001

APPTAINER_BIN=apptainer
APPTAINER_IMAGE_DIR=.apptainer/images
APPTAINER_CACHE_DIR=.apptainer/cache
NEUROCADE_CONTAINER_ROOT=.apptainer/containers
NEUROCADE_CONTAINER_INVENTORY=llm-data/tool-catalog/installed_containers.json
NEUROCADE_INSTALLED_TOOLS_JSONL=llm-data/tool-catalog/installed_tools.jsonl
POSTGRES_SIF=.apptainer/images/postgres-16-alpine.sif
REDIS_SIF=.apptainer/images/redis-7-alpine.sif
TRAEFIK_SIF=.apptainer/images/traefik-v2.11.14.sif
FASTSURFER_DEVICE_MODE=auto
WORKER_CONCURRENCY=2
API_WORKER_CONCURRENCY=2
DICOM_RAW_RETENTION=discard
DICOM_CONVERSION_TIMEOUT_SECONDS=300
MAX_UPLOAD_FILE_SIZE_BYTES=2147483648
DICOM_ZIP_MAX_ENTRIES=5000
DICOM_ZIP_MAX_EXPANDED_BYTES=4294967296
REDIS_PASSWORD=CHANGE_ME
POSTGRES_USER=neurocade_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=neurocade_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:56379/0
DATABASE_URL=postgresql+psycopg://neurocade_user:CHANGE_ME@127.0.0.1:55432/neurocade_db
API_SERVICE_URL=http://127.0.0.1:58080
ASSISTANT_MAX_ROUNDS=18
MONITORING_ADMIN_USER_IDS=demo-user
MONITORING_ACTIVE_WINDOW_MINUTES=15
MONITORING_EVENT_RETENTION_DAYS=30

APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8005
TRAEFIK_DASHBOARD_ENABLED=false
TRAEFIK_API_INSECURE=false
TRAEFIK_DASHBOARD_BIND=127.0.0.1
TRAEFIK_DASHBOARD_PORT=8080

# Local installs only. Keep false for any shared deployment.
LOCAL_AUTH_ENABLED=true
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_JWT_TEMPLATE=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

LLM_PROVIDER_DEFAULT=openai-compatible
WORKFLOW_DEFAULT_PROVIDER=openai-compatible
LLM_NATIVE_TOOL_CALLING=false
LLM_JSON_MODE=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Absolute path on the host to the NeuroCade data directory.
HOST_DATA_DIR=NOTSET

# Highly recommended: path to a valid FreeSurfer license file.
# If unset, the app can start, but real MRI processing needs a license at
# neurocade-data/license.txt or this explicit path.
# Free licenses are available at:
# https://surfer.nmr.mgh.harvard.edu/registration.html
FREESURFER_LICENSE=

# ---------------------------------------------------------------------------
# LLM Backend (OpenAI-compatible endpoint)
# Configure your OpenAI-compatible base URL. `backend_common.providers` appends /v1.
# Leave LLM_BACKEND_API_KEY blank for no-auth backends.
LLM_BACKEND_URL=
LLM_BACKEND_API_KEY=
LLM_BACKEND_MODEL=Qwen/Qwen3.6-35B-A3B

# Optional: local Gemma 4 via Ollama
# Start the app with: ./scripts/apptainer/up.sh -d
# The current recommended model for ~16 GB GPUs is gemma4:e2b.
# LLM_BACKEND_URL=http://127.0.0.1:11434
# LLM_BACKEND_API_KEY=
# LLM_BACKEND_MODEL=gemma4:e2b
# OLLAMA_MODEL=gemma4:e2b
# LLM_NATIVE_TOOL_CALLING=false
