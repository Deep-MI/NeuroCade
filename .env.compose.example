APP_BASE_URL=http://localhost:8005
APP_PUBLIC_URL=http://localhost:8005
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8005

LOCAL_AUTH_ENABLED=true
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
RUNTIME_RUNNER_TOKEN=CHANGE_ME

# Absolute host path exported by scripts/compose/*. Defaults to ./neurocade-data
# when invoking docker compose directly.
NEUROCADE_HOST_DATA_DIR=
HOST_DATA_DIR=/data

FASTSURFER_DEVICE_MODE=auto
NEUROCADE_DOCKER_GPU=false
NEUROCADE_BASH_IMAGE=neurocade-runtime-bash:local

VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_JWT_TEMPLATE=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

LLM_PROVIDER_DEFAULT=openai-compatible
WORKFLOW_DEFAULT_PROVIDER=openai-compatible
LLM_NATIVE_TOOL_CALLING=false
LLM_JSON_MODE=true
LLM_BACKEND_URL=
LLM_BACKEND_API_KEY=
LLM_BACKEND_MODEL=Qwen/Qwen3.6-35B-A3B
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
