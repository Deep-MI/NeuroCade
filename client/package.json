{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "predev": "node ./scripts/applyNiivuePatches.mjs",
    "dev": "vite",
    "prebuild": "node ./scripts/applyNiivuePatches.mjs",
    "build": "tsc -b && vite build && node ./scripts/checkBundleSize.mjs",
    "preelectron:local": "node ./scripts/applyNiivuePatches.mjs",
    "electron:local": "bash ../scripts/desktop/run.sh",
    "lint": "eslint .",
    "test:node": "node -e \"require('node:fs').rmSync('.tmp-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test .tmp-test/tests/*.test.js",
    "check": "npm run lint && npm run test:node && npm run build && npm audit --audit-level=high",
    "preview": "vite preview",
    "auth:state": "node ./scripts/prepareClerkStorageState.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.20.0",
    "@niivue/niivue": "1.0.0-rc.12",
    "lucide-react": "^0.562.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.14",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.23",
    "electron": "^41.10.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.2"
  },
  "overrides": {
    "js-cookie": "3.0.7"
  }
}
